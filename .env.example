# =============================================================================
# VehicleSphere Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vehiclesphere
DB_USERNAME=vehiclesphere
DB_PASSWORD=vehiclesphere

# --- JWT Configuration ---
# Minimum 64 characters for HS512.
JWT_SECRET=changeThisToAVeryLongAndSecureRandomSecretKeyForProductionUse2024VehicleSphere
JWT_EXPIRATION=86400000

# --- Server Configuration ---
SERVER_PORT=8080

# --- CORS Configuration ---
CORS_ORIGINS=http://localhost:5173

# --- Razorpay Payment Gateway (Test Mode) ---
# Sign up at https://dashboard.razorpay.com and generate test API keys in Settings > API Keys
# Default mock values allow instant testing with built-in sandbox simulation
RAZORPAY_KEY_ID=rzp_test_VehicleSphereMock
RAZORPAY_KEY_SECRET=MockSecretKeyVehicleSphereTest123

# --- Mail / SMTP Configuration ---
# Leave MAIL_ENABLED=false for local development fallback (logs email bodies safely to console)
# To send real emails via Gmail: generate an App Password in your Google Account security settings
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-app-password
MAIL_FROM=noreply@vehiclesphere.com

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:8080/api/v1

# =============================================================================
# VehicleSphere — Master Environment Configuration Template (.env.example)
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Replace all placeholder values below with your specific environment credentials.
# 3. NEVER commit the actual .env file or real secrets to version control.
# =============================================================================

# --- Application Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Server Configuration ---
SERVER_PORT=8080

# --- Database Configuration (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vehiclesphere
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_secure_db_password_here

# --- JSON Web Token (JWT) Security ---
# Generate a cryptographically secure random secret (minimum 64 characters for HMAC-SHA512)
JWT_SECRET=your_secure_random_jwt_secret_must_be_at_least_64_characters_long_here
# Token expiration in milliseconds (e.g. 86400000 ms = 24 hours)
JWT_EXPIRATION=86400000

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Payment Gateway (Razorpay - Test Mode) ---
# Sign up at https://dashboard.razorpay.com and generate Test API Keys in Settings > API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- Mail / SMTP Configuration ---
# Set MAIL_ENABLED=true only if real outbound SMTP delivery is required
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email_address_here@example.com
MAIL_PASSWORD=your_smtp_app_password_here
MAIL_FROM=notifications@vehiclesphere.com

# --- Frontend Web Client ---
VITE_API_URL=http://localhost:8080/api/v1
